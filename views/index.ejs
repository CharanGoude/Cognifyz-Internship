<!DOCTYPE html>
<html>
<head>
  <title>Cognifyz - Where Data Meets Intelligence</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container mt-5">
    <h1>Cognifyz</h1>
    <p>Where Data Meets Intelligence</p>
    <% if (user) { %>
      <a href="/form" class="btn btn-primary">Submit Data</a>
      <a href="/data" class="btn btn-secondary">View Data</a>
      <span class="ms-3">Welcome, <%= user.username %></span>
    <% } else { %>
      <a href="/login" class="btn btn-primary">Login</a>
      <a href="/register" class="btn btn-secondary">Register</a>
    <% } %>
  </div>
</body>
</html>
