<!DOCTYPE html>
<html>
<head>
  <title>Submit Data - Cognifyz</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <script>
    function validateForm() {
      const name = document.forms["dataForm"]["name"].value;
      const email = document.forms["dataForm"]["email"].value;
      const password = document.forms["dataForm"]["password"].value;
      if (!name || !email || password.length < 6) {
        alert("All fields required. Password must be at least 6 characters.");
        return false;
      }
      return true;
    }
  </script>
</head>
<body>
  <div class="container mt-5">
    <h2>Submit Data</h2>
    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form name="dataForm" method="POST" action="/form" onsubmit="return validateForm()">
      <input type="text" name="name" class="form-control mb-2" placeholder="Name" required>
      <input type="email" name="email" class="form-control mb-2" placeholder="Email" required>
      <input type="password" name="password" class="form-control mb-2" placeholder="Password" required>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </div>
</body>
</html>
